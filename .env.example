# Google AI Studio / Gemini API Key (Required for scriptwriting & Imagen 3)
GEMINI_API_KEY=your_gemini_api_key_here

# ElevenLabs API Key (Optional for custom TTS voice cloning)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Stock Image APIs (Optional for content-matched visual fallbacks)
PEXELS_API_KEY=your_pexels_api_key_here
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
UNSPLASH_SECRET_KEY=your_unsplash_secret_key_here

# Server Port (Default 3000)
PORT=3000
